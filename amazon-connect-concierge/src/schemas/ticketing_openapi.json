{
  "openapi": "3.0.0",
  "info": {
    "title": "Legacy Support Ticketing & Returns API",
    "description": "API for opening support tickets, initiating item exchanges, and requesting return labels.",
    "version": "1.0.0"
  },
  "paths": {
    "/tickets/create": {
      "post": {
        "summary": "Create a support ticket or return request",
        "operationId": "createSupportTicket",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "customer_id": { "type": "string", "description": "Customer Profile ID or email" },
                  "order_id": { "type": "string", "description": "Associated order identifier" },
                  "issue_category": { "type": "string", "enum": ["RETURN", "EXCHANGE", "DAMAGED_ITEM", "SHIPPING_DELAY", "OTHER"] },
                  "description": { "type": "string", "description": "Detailed description of the issue" }
                },
                "required": ["customer_id", "issue_category", "description"]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Ticket created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ticket_id": { "type": "string" },
                    "status": { "type": "string", "enum": ["OPEN", "PENDING_APPROVAL", "RESOLVED"] },
                    "priority": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH"] },
                    "estimated_resolution_hours": { "type": "integer" },
                    "created_at": { "type": "string" }
                  },
                  "required": ["ticket_id", "status", "priority", "created_at"]
                }
              }
            }
          }
        }
      }
    }
  }
}
