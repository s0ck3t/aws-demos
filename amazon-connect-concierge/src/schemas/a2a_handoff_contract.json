{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "A2AJsonRpcTaskRequest",
  "type": "object",
  "required": [
    "jsonrpc",
    "method",
    "params",
    "id"
  ],
  "properties": {
    "jsonrpc": {
      "type": "string",
      "enum": ["2.0"]
    },
    "method": {
      "type": "string",
      "enum": ["tasks/send", "a2a/handoff"]
    },
    "id": {
      "type": ["string", "number"]
    },
    "params": {
      "type": "object",
      "required": [
        "task_id",
        "session_id",
        "origin_agent_id",
        "target_agent_id",
        "customer_profile",
        "context_snapshot"
      ],
      "properties": {
        "task_id": { "type": "string" },
        "session_id": { "type": "string" },
        "origin_agent_id": { "type": "string" },
        "target_agent_id": { "type": "string" },
        "customer_profile": {
          "type": "object",
          "required": ["profile_id", "email"],
          "properties": {
            "profile_id": { "type": "string" },
            "email": { "type": "string" },
            "phone_number": { "type": "string" },
            "first_name": { "type": "string" },
            "last_name": { "type": "string" }
          }
        },
        "context_snapshot": {
          "type": "object",
          "required": ["intent", "dialogue_summary"],
          "properties": {
            "intent": { "type": "string" },
            "dialogue_summary": { "type": "string" },
            "order_id": { "type": "string" },
            "sku": { "type": "string" },
            "return_reason": { "type": "string" },
            "item_price_gbp": { "type": "number" },
            "purchase_date": { "type": "string" },
            "fraud_risk_score": { "type": "number" }
          }
        }
      }
    }
  }
}
